# RevCrew configuration
# Copy to .env and fill in what you need. The demo runs with everything left
# as-is: empty secrets keep every integration on its mock adapter.

# Mode: set DEMO_MODE=false for live integrations
DEMO_MODE=true
ENV=dev

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://revcrew:revcrew@localhost:5541/revcrew

# Anthropic API key: required only for live agent runs
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5-20251001

# Slack: bot token and signing secret from api.slack.com
# Setting SLACK_BOT_TOKEN in demo mode switches chat to live Slack while
# CRM and outreach stay mocked. Leave empty for full mock.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# HubSpot: private app token from a developer test account
HUBSPOT_PRIVATE_APP_TOKEN=

# Instantly: API v2 key and webhook secret
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=

# Agno Viz tracing: leave empty to disable
TRACING_ENABLED=false
AGNO_VIZ_SPANS_URL=
AGNO_VIZ_INGEST_TOKEN=

# ICP scoring threshold (0-100)
ICP_SCORE_THRESHOLD=70
