# RevCrew configuration
# Copy to .env and fill in what you need. The demo runs with everything left
# as-is: empty secrets keep every integration on its mock adapter.

# Mode: set DEMO_MODE=false for live integrations
DEMO_MODE=true
ENV=dev

# Database (matches docker-compose.yml)
DATABASE_URL=postgresql://revcrew:revcrew@localhost:5541/revcrew

# Anthropic API key: required only for live agent runs
ANTHROPIC_API_KEY=
MODEL_MAIN=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5-20251001

# Model provider: auto | anthropic | ollama.
# auto = Ollama when OLLAMA_HOST or OLLAMA_API_KEY is set, else Anthropic.
# Local Ollama: set OLLAMA_HOST (e.g. http://localhost:11434).
# ollama.cloud: set OLLAMA_API_KEY and leave OLLAMA_HOST empty.
MODEL_PROVIDER=auto
OLLAMA_HOST=
OLLAMA_API_KEY=
# Local Ollama model names. ollama.cloud uses its own ids (for example glm-5.2 and
# glm-5.3-flash); list yours with: curl -H "Authorization: Bearer $OLLAMA_API_KEY" https://ollama.com/api/tags
OLLAMA_MODEL_MAIN=qwen3:14b
OLLAMA_MODEL_FAST=qwen3:4b

# Research stack (docs/research-stack.md). Every key is optional. With none
# set: Tier 0 signals (job boards, news RSS) + DuckDuckGo search + Jina Reader
# / direct fetch. Each key upgrades one tier; the ledger records which ran.
RESEARCH_PROVIDER=auto            # scrape tier: auto | basic | firecrawl
FIRECRAWL_API_KEY=                # Tier 2 scrape + JSON extraction (+ Tier 1 search fallback)
SERPER_API_KEY=                   # Tier 1 Google SERP, ~$0.001/query prepaid
SERPER_GL=au                      # Google country code for search results
JINA_API_KEY=                     # optional; r.jina.ai works keyless at a lower rate limit
BROWSERBASE_API_KEY=              # Tier 3 browser hands (Stagehand on Browserbase)
BROWSERBASE_PROJECT_ID=
RESEARCH_BROWSER_ENABLED=false    # the browser tier is opt-in even when configured
STAGEHAND_MODEL=                  # "anthropic/claude-haiku-4-5" etc; empty = Browserbase Model Gateway
STAGEHAND_MODEL_API_KEY=          # empty = ANTHROPIC_API_KEY for anthropic/* models
RESEARCH_DENY_DOMAINS=            # comma-separated, added to the built-in deny list (LinkedIn, social, review sites)
RESEARCH_CACHE_TTL_HOURS=48       # a page fetched inside this window is served from the ledger, free
# Per-account budget. A call that would breach it is refused and recorded.
RESEARCH_MAX_CALLS_PER_ACCOUNT=25
RESEARCH_MAX_CREDITS_PER_ACCOUNT=40
RESEARCH_MAX_BROWSER_SECONDS_PER_ACCOUNT=180
RESEARCH_MAX_USD_PER_ACCOUNT=0.50

# Slack: bot token and signing secret from api.slack.com
# Setting SLACK_BOT_TOKEN in demo mode switches chat to live Slack while
# CRM and outreach stay mocked. Leave empty for full mock.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# HubSpot: private app token from a developer test account
HUBSPOT_PRIVATE_APP_TOKEN=
# Optional: HubSpot owner ID for tasks created without an explicit owner
HUBSPOT_DEFAULT_OWNER_ID=

# Instantly: API v2 key and webhook secret
INSTANTLY_API_KEY=
INSTANTLY_WEBHOOK_SECRET=

# Tracing. TRACING_ENABLED=true writes agno's OpenTelemetry spans into this
# Postgres (agno_traces / agno_spans) for AgentOS's run tree. The Agno Viz
# bridge is additive and needs the pair below plus the agno-viz package.
TRACING_ENABLED=false
AGNO_VIZ_SPANS_URL=
AGNO_VIZ_INGEST_TOKEN=

# ICP scoring threshold (0-100): the B tier cutoff and the pipeline gate
ICP_SCORE_THRESHOLD=70
# ICP rubric file. Empty = app/icp.yaml. Point at your own copy to keep your
# rubric out of the repo.
ICP_PATH=

# Copilot skills: the playbooks in skills/ that the Slack copilot loads on
# demand. false turns the mechanism off entirely.
SKILLS_ENABLED=true
# Skills directory. Empty = skills/ at the repo root. Point at your own copy to
# keep your playbooks and proof points out of the repo.
SKILLS_PATH=

# Approval experience
APPROVAL_REMINDER_HOURS=24
APPROVAL_TTL_HOURS=72
# Comma-separated Slack user IDs allowed to approve/reject. Empty = anyone.
APPROVER_SLACK_IDS=

# Time zone for agents (every date they see is labelled with its weekday in
# this zone) and for scheduled jobs. Set it to yours; UTC is the honest default.
TIMEZONE=UTC

# Daily digest (posted to SLACK_CHANNEL_ID). DIGEST_TZ empty = TIMEZONE.
DIGEST_HOUR=8
DIGEST_TZ=

# Guarded CRM writes
MAX_WRITES_PER_CONTEXT=20
MAX_DEAL_AMOUNT=10000000
DEAL_DEDUP=true

# Audit / approval retention, days
RETENTION_DAYS=90

# Bearer token protecting the AgentOS API endpoints. Set this on any
# reachable deployment.
OS_SECURITY_KEY=
